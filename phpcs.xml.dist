<?xml version="1.0"?>
<ruleset name="dsgourakis">
	<description>WordPress Coding Standards for the dsgourakis.com theme and plugin.</description>

	<!-- What to check. -->
	<file>./plugins/dsg-core</file>
	<file>./themes/dsg-theme</file>

	<!-- What to skip: dependencies and generated files. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- Lowest PHP and WordPress versions the code must support. -->
	<config name="testVersion" value="8.2-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<rule ref="WordPress">
		<!--
			Classes in includes/ follow PSR-4 (Composer autoloading), so the file
			name matches the class name (Project.php) instead of class-project.php.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Every translatable string must use one of these text domains. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="dsg-core"/>
				<element value="dsg-theme"/>
			</property>
		</properties>
	</rule>

	<!--
		Every global function, constant, variable and hook must start with one of these prefixes.
		WPCS requires each prefix to be at least 4 characters long.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="dsg_core"/>
				<element value="dsg_theme"/>
				<element value="DSG\Core"/>
			</property>
		</properties>
	</rule>

	<!--
		A block's render.php is included inside a WordPress function, so its
		variables are local, not global, and don't need the prefix.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>*/render.php</exclude-pattern>
	</rule>

	<!-- Test method names describe themselves, so they don't need a docblock each. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
