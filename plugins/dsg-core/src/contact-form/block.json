{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dsg/contact-form",
	"version": "0.1.0",
	"title": "Contact Form",
	"category": "widgets",
	"icon": "email",
	"description": "Name, email and message fields. Messages are saved under Messages in wp-admin and emailed to you. Works with or without JavaScript.",
	"keywords": [ "contact", "form", "email", "message" ],
	"textdomain": "dsg-core",
	"attributes": {
		"buttonLabel": {
			"type": "string",
			"default": ""
		},
		"successMessage": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"interactivity": true,
		"spacing": {
			"margin": [ "top", "bottom" ]
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": "file:./style-index.css"
}
