{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dsg/hero",
	"version": "0.1.0",
	"title": "Hero",
	"category": "design",
	"icon": "cover-image",
	"description": "The homepage intro: a big heading, a short tagline, buttons, and a tilted monogram letter on the right.",
	"keywords": [ "intro", "banner", "heading", "monogram" ],
	"textdomain": "dsg-core",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"tagline": {
			"type": "string",
			"default": ""
		},
		"monogram": {
			"type": "string",
			"default": "D"
		},
		"showCodeTags": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": [ "top", "bottom" ],
			"padding": [ "top", "bottom" ]
		}
	},
	"example": {
		"attributes": {
			"heading": "Hi,<br>I'm <mark class=\"has-inline-color has-accent-color\">D</mark>imitris,<br>web developer.",
			"tagline": "WordPress developer / Full-stack / Responsive builds"
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
