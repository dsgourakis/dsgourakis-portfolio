{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dsg/project-card",
	"version": "0.2.0",
	"title": "Project Card",
	"category": "design",
	"icon": "portfolio",
	"description": "A portfolio project with image, title, summary and a link. A featured card shown first in its group gets the large, full-row layout.",
	"keywords": [ "portfolio", "project", "card" ],
	"textdomain": "dsg-core",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"summary": {
			"type": "string",
			"default": ""
		},
		"url": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number"
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"technologies": {
			"type": "array",
			"items": { "type": "string" },
			"default": []
		},
		"featured": {
			"type": "boolean",
			"default": false
		},
		"imagePriority": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide" ],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"example": {
		"attributes": {
			"title": "Hellenic Red Cross",
			"summary": "Custom WordPress theme with reusable blocks and a full content migration.",
			"technologies": [ "WordPress", "PHP", "ACF" ],
			"featured": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
