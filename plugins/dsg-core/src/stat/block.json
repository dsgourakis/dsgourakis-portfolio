{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dsg/stat",
	"version": "0.4.0",
	"title": "Stat",
	"category": "design",
	"icon": "chart-bar",
	"description": "A card with a pre-title, title and text. Lives inside a Stats block: the first Stat is shown as a big number; the others are numbered “01 / pre-title”.",
	"parent": [ "dsg/stats" ],
	"keywords": [ "number", "metric", "counter", "service", "card" ],
	"textdomain": "dsg-core",
	"attributes": {
		"pretitle": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"example": {
		"attributes": {
			"pretitle": "build",
			"title": "WordPress development",
			"description": "Custom themes, blocks and plugins on PHP and the WordPress ecosystem."
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
