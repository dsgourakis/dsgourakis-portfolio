{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dsg/stats",
	"version": "0.1.0",
	"title": "Stats",
	"category": "design",
	"icon": "grid-view",
	"description": "A grid of Stat cards. The first Stat is shown as a big number; the others are numbered.",
	"keywords": [ "stats", "numbers", "services", "grid" ],
	"textdomain": "dsg-core",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": [ "top", "bottom" ]
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
