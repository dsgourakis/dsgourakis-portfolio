{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "base", "name": "Background", "color": "#161616" },
				{ "slug": "surface", "name": "Surface", "color": "#1F1F1F" },
				{ "slug": "border", "name": "Border", "color": "#343434" },
				{ "slug": "contrast", "name": "Text", "color": "#F3F3F3" },
				{ "slug": "muted", "name": "Muted text", "color": "#A3A3A3" },
				{ "slug": "accent", "name": "Accent (cobalt)", "color": "#5B8CFF" },
				{ "slug": "accent-2", "name": "Accent 2 (amber)", "color": "#FFB547" },
				{ "slug": "on-accent", "name": "Text on accent", "color": "#0B0B0B" },
				{ "slug": "danger", "name": "Error", "color": "#FF8A80" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Schibsted Grotesk",
					"fontFamily": "\"Schibsted Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/schibsted-grotesk-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/jetbrains-mono-latin-wght-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Label (13px)", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small (15px)", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Body (17px)", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large (22px)", "size": "1.375rem", "fluid": false },
				{ "slug": "x-large", "name": "Card title (26px)", "size": "1.625rem", "fluid": { "min": "1.375rem", "max": "1.625rem" } },
				{ "slug": "xx-large", "name": "Feature title (34px)", "size": "2.125rem", "fluid": { "min": "1.75rem", "max": "2.125rem" } },
				{ "slug": "section", "name": "Section heading", "size": "clamp(2.25rem, 4vw, 3.25rem)", "fluid": false },
				{ "slug": "display", "name": "Display", "size": "clamp(2.5rem, 5vw, 4.25rem)", "fluid": false },
				{ "slug": "stat", "name": "Stat number", "size": "4rem", "fluid": { "min": "3rem", "max": "4rem" } },
				{ "slug": "hero", "name": "Hero", "size": "clamp(3rem, 7.5vw, 6.5rem)", "fluid": false }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "2XS (8px)", "size": "0.5rem" },
				{ "slug": "20", "name": "XS (12px)", "size": "0.75rem" },
				{ "slug": "30", "name": "S (16px)", "size": "1rem" },
				{ "slug": "40", "name": "M (24px)", "size": "1.5rem" },
				{ "slug": "50", "name": "L (32px)", "size": "2rem" },
				{ "slug": "60", "name": "Card padding (24–48px)", "size": "clamp(1.5rem, 4vw, 3rem)" },
				{ "slug": "70", "name": "Section (64px)", "size": "clamp(3rem, 6vw, 4rem)" },
				{ "slug": "80", "name": "XL (80px)", "size": "clamp(3.5rem, 8vw, 5rem)" }
			]
		},
		"custom": {
			"radius": {
				"inner": "14px",
				"card": "20px",
				"panel": "24px",
				"pill": "99px"
			},
			"letter-spacing": {
				"tightest": "-0.045em",
				"tighter": "-0.03em",
				"tight": "-0.02em",
				"label": "0.12em",
				"caps": "0.18em"
			},
			"easing": "cubic-bezier(0.2, 0.7, 0.2, 1)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1.1",
					"letterSpacing": "var(--wp--custom--letter-spacing--tight)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--hero)",
					"lineHeight": "0.98",
					"letterSpacing": "var(--wp--custom--letter-spacing--tightest)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--section)",
					"lineHeight": "1.05",
					"letterSpacing": "var(--wp--custom--letter-spacing--tighter)"
				}
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
			},
			"h4": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "700" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--on-accent)"
				},
				"border": {
					"radius": "0",
					"width": "1.5px",
					"style": "solid",
					"color": "var(--wp--preset--color--accent)"
				},
				"spacing": {
					"padding": { "top": "1rem", "bottom": "1rem", "left": "1.75rem", "right": "1.75rem" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "400",
					"letterSpacing": "var(--wp--custom--letter-spacing--caps)",
					"textTransform": "uppercase",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					},
					"border": { "color": "var(--wp--preset--color--contrast)" }
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)" },
				"color": { "text": "var(--wp--preset--color--muted)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "900",
					"letterSpacing": "var(--wp--custom--letter-spacing--tighter)"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" },
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/code": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "page-header", "title": "Page header (title + excerpt)", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-reading", "title": "Reading", "postTypes": [ "page" ] }
	]
}
